*/**/input

# Linter / formatter caches
# Ruff writes a .gitignore containing '*' inside .ruff_cache, so this is belt and
# braces - but relying on that is accidental, and `git check-ignore .ruff_cache`
# reports the directory itself as not ignored.
-.ruff_cache/

# Ignore Claude-related directories (any depth)
.claude/
**/.claude/

# Ignore any 'codex' directories (any depth)
codex/
**/codex/
